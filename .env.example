# Exemplo de variáveis para rodar o app com um Supabase próprio.
# Substitua os valores pelos do seu novo projeto Supabase.

# Server-side
SUPABASE_URL=https://<novo>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon-key-do-novo>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-do-novo>
SUPABASE_PROJECT_ID=<id-do-novo>

# Client-side (visíveis no navegador)
VITE_SUPABASE_URL=https://<novo>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-key-do-novo>
VITE_SUPABASE_PROJECT_ID=<id-do-novo>

# Aplicativo e login social nativo no novo ambiente
VITE_APP_URL=https://<seu-app>.vercel.app
VITE_AUTH_MODE=supabase

# Notificações (somente no servidor, nunca prefixar com VITE_)
CRON_SECRET=<segredo-aleatorio-forte>
VAPID_PUBLIC_KEY=<chave-publica-vapid>
VAPID_PRIVATE_KEY=<chave-privada-vapid>
VAPID_SUBJECT=mailto:<email-do-remetente>
